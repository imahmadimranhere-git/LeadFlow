# Frontend env — ONLY public values here. Anything starting with VITE_ is visible in the browser.
# NEVER put API keys, JWT secrets or DB URIs here.

# Development (your PC):
VITE_API_URL=http://localhost:5000/api/v1

# Production (Vercel → Project → Settings → Environment Variables):
#   VITE_API_URL=/api/v1
# "/api/v1" = same domain; Vercel forwards /api to the Render API (client/vercel.json) → the login cookie just works.
