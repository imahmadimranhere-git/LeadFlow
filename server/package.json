{
  "name": "leadflow-erp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node scripts/runTests.mjs",
    "seed": "node scripts/seed.js",
    "rotate-keys": "node scripts/rotateKeys.js",
    "webhook:test": "node scripts/sendTestWebhook.js",
    "test:pure": "node scripts/runTests.mjs --pure",
    "test:coverage": "node scripts/runTests.mjs --coverage",
    "security:scan": "node scripts/securityScan.mjs",
    "secrets:generate": "node scripts/generateSecrets.mjs",
    "check:prod": "node scripts/checkProductionEnv.mjs",
    "smoke": "node scripts/smokeTest.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "db:indexes": "node scripts/checkIndexes.mjs",
    "tenant:purge": "node scripts/purgeTenant.mjs",
    "load": "node scripts/loadTest.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^9.0.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  }
